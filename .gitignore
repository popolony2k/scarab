# Local, per-developer VSCode config - the tracked source of truth lives in
# docs/vscode/.vscode (see docs/vscode/README.md); copy from there instead
# of editing here directly, so intentional changes don't get lost.
/.vscode/

# Generated Doxygen output (doxygen.yml regenerates it on every push/PR to
# main and deploys it to GitHub Pages - not meant to be committed).
docs/doxygen/

__pycache__/
*.pyc

# tools/pack.lua's own local, per-developer config (see tools/README.md) -
# points at wherever your own game source/output actually live, run from
# the repo root the same way every samples/ entry already is; never meant
# to be tracked (it may reference private absolute paths outside this repo
# entirely).
/pack-config.json
